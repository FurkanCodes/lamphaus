# Copy to .env.local and fill in. Both values are publishable by design
# (same model as the Android BuildConfig keys) — they identify the project,
# they do not authorize anything without RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only needed when simulating the Pages sub-path locally:
# PAGES_BASE_PATH=/lamphaus
