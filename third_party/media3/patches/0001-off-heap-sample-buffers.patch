+package androidx.media3.exoplayer.upstream;
+
+import androidx.annotation.Nullable;
+import androidx.media3.common.util.UnstableApi;
+import java.nio.ByteBuffer;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ScheduledExecutorService;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Off-heap memory for buffered media (Lamphaus native memory patch).
+ *
+ * <p>Each buffer is a zeroed native block wrapped as a direct {@link ByteBuffer}, so it does not
+ * count against the Java heap limit. Java code reads and writes it only through bounds-checked
+ * {@link ByteBuffer} calls; native code only allocates and frees. Freeing is deferred by a few
+ * seconds, so a late access while a loader winds down never reaches freed memory.
+ */
+@UnstableApi
+public final class NativeBuffers {
+
+  private static final String LIBRARY_NAME = "lamphaus_media3_native";
+  private static final long FREE_DELAY_MS = 5_000;
+
+  private static final AtomicLong allocatedBytes = new AtomicLong();
+  private static final ScheduledExecutorService freer =
+      Executors.newSingleThreadScheduledExecutor(
+          runnable -> {
+            Thread thread = new Thread(runnable, "Media3NativeBufferFree");
+            thread.setDaemon(true);
+            return thread;
+          });
+
+  private static volatile boolean loadAttempted;
+  private static volatile boolean available;
+
+  private NativeBuffers() {}
+
+  /** Whether the native library loaded on this device. */
+  public static boolean isAvailable() {
+    if (!loadAttempted) {
+      synchronized (NativeBuffers.class) {
+        if (!loadAttempted) {
+          try {
+            System.loadLibrary(LIBRARY_NAME);
+            available = true;
+          } catch (Throwable error) {
+            available = false;
+          }
+          loadAttempted = true;
+        }
+      }
+    }
+    return available;
+  }
+
+  /**
+   * Returns a zeroed off-heap buffer of {@code size} bytes, or null when native memory is
+   * unavailable or exhausted.
+   */
+  @Nullable
+  public static ByteBuffer allocate(int size) {
+    if (size <= 0 || !isAvailable()) {
+      return null;
+    }
+    @Nullable ByteBuffer buffer = nativeAllocate(size);
+    if (buffer != null) {
+      allocatedBytes.addAndGet(size);
+    }
+    return buffer;
+  }
+
+  /**
+   * Frees a buffer returned by {@link #allocate(int)} after a short delay. The caller must not use
+   * the buffer, or any duplicate of it, afterwards.
+   */
+  public static void free(ByteBuffer buffer) {
+    freer.schedule(
+        () -> {
+          allocatedBytes.addAndGet(-buffer.capacity());
+          nativeFree(buffer);
+        },
+        FREE_DELAY_MS,
+        TimeUnit.MILLISECONDS);
+  }
+
+  /** Returns the off-heap bytes currently allocated, for diagnostics. */
+  public static long getAllocatedBytes() {
+    return allocatedBytes.get();
+  }
+
+  @Nullable
+  private static native ByteBuffer nativeAllocate(int size);
+
+  private static native void nativeFree(ByteBuffer buffer);
+}
