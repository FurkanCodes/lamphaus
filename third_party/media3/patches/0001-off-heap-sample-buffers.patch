index 0000000..5b4299c
--- /dev/null
+++ b/libraries/exoplayer/src/main/jni/native_buffers.c
@@ -0,0 +1,39 @@
+/*
+ * Copyright 2026 Lamphaus. Licensed under the Apache License, Version 2.0.
+ *
+ * Off-heap memory for androidx.media3.exoplayer.upstream.NativeBuffers (Lamphaus native memory
+ * patch). Only allocation and release happen here; every read and write goes through Java's
+ * bounds-checked ByteBuffer calls.
+ */
+#include <jni.h>
+#include <stdlib.h>
+
+JNIEXPORT jobject JNICALL
+Java_androidx_media3_exoplayer_upstream_NativeBuffers_nativeAllocate(JNIEnv *env, jclass clazz,
+                                                                     jint size) {
+  (void) clazz;
+  if (size <= 0) {
+    return NULL;
+  }
+  void *memory = calloc(1, (size_t) size);
+  if (memory == NULL) {
+    return NULL;
+  }
+  jobject buffer = (*env)->NewDirectByteBuffer(env, memory, (jlong) size);
+  if (buffer == NULL) {
+    (*env)->ExceptionClear(env);
+    free(memory);
+    return NULL;
+  }
+  return buffer;
+}
+
+JNIEXPORT void JNICALL
+Java_androidx_media3_exoplayer_upstream_NativeBuffers_nativeFree(JNIEnv *env, jclass clazz,
+                                                                 jobject buffer) {
+  (void) clazz;
+  if (buffer == NULL) {
+    return;
+  }
+  free((*env)->GetDirectBufferAddress(env, buffer));
+}
