<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview art for the Continue watching widget: a card with its title, episode, and progress. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#101218" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:start="8dp" android:top="8dp" android:end="8dp" android:bottom="8dp">
        <shape>
            <gradient android:angle="315" android:startColor="#2B3A55" android:endColor="#0E1830" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:start="18dp" android:end="60dp" android:bottom="40dp" android:gravity="bottom" android:height="8dp">
        <shape>
            <solid android:color="#F2F4F8" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:start="18dp" android:end="90dp" android:bottom="28dp" android:gravity="bottom" android:height="6dp">
        <shape>
            <solid android:color="#9AA1AF" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:start="18dp" android:end="18dp" android:bottom="16dp" android:gravity="bottom" android:height="3dp">
        <shape>
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:start="18dp" android:end="70dp" android:bottom="16dp" android:gravity="bottom" android:height="3dp">
        <shape>
            <solid android:color="#A8C8FF" />
        </shape>
    </item>
</layer-list>
