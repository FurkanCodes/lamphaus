rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function activeDevice(uid) {
      return !('deviceId' in request.auth.token) ||
        get(/databases/$(database)/documents/users/$(uid)/devices/$(request.auth.token.deviceId)).data.revoked == false;
    }

    function validOwner(uid) {
      return owns(uid) && activeDevice(uid);
    }

    match /users/{uid} {
      allow read, create, update, delete: if validOwner(uid);

      match /profiles/{profileId} {
        allow read, write: if validOwner(uid);

        match /library/{mediaKey} {
          allow read, write: if validOwner(uid);
        }

        match /progress/{videoKey} {
          allow read, write: if validOwner(uid);
        }
      }

      match /devices/{deviceId} {
        allow read: if validOwner(uid);
        allow write: if false;
      }

      match /providers/{providerId} {
        allow read, write: if false;
      }
    }

    match /pairingSessions/{sessionId} {
      allow read, write: if false;
    }

    match /pairingRateLimits/{key} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

